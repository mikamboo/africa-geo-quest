  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
